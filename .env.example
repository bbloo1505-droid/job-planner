# Stage 1 does not require secrets for OpenFreeMap or the local MapLibre map.
# Do not put unrestricted keys in source.

# Basemap: openfreemap (default) | local-maplibre | google
NEXT_PUBLIC_MAP_PROVIDER=openfreemap

# Address search (Day Route only). Browser calls /api/geocode — never Nominatim from React.
# nominatim (default prototype) | local-lookup
NEXT_PUBLIC_GEOCODING_PROVIDER=nominatim
GEOCODING_PROVIDER=nominatim
# Optional identifying User-Agent for the public Nominatim policy.
GEOCODING_USER_AGENT=PrensaFieldAllocation/0.1 (prototype; https://github.com/bbloo1505-droid/job-planner)

# Browser Maps JavaScript API key for the optional Google provider.
# Restrict in Google Cloud: HTTP referrers (localhost for dev) + Maps JavaScript API only.
# Do not enable Geocoding, Places, Routes, Directions, or Address Validation for this prototype.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
